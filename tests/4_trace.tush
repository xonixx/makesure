@ + [[ 1 -eq 2 ]]
@ + : goal2@reached_if
@~\+ cd .+/tests
@ + A=aaa
@ + export A
@ + true
@ + : goal1
@~\+ cd .+/tests
@ + A=aaa
@ + export A
@ + echo goal1
