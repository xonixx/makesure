
$ ./{{MAKESURE}} -f tests/4_trace.sh
|   goal 'goal2' [already satisfied].
|   goal 'goal1' ...
| goal1
|   goal 'default' ...
| A=aaa

$ ./{{MAKESURE}} -f tests/4_trace.sh -x
|   goal 'goal2' [already satisfied].
|   goal 'goal1' ...
| goal1
|   goal 'default' ...
| A=aaa
@ + : default@reached_if
@~\+ cd .+/tests
@ + A=aaa
@ + export A
@ + [[ 1 -eq 2 ]]
@ + : goal2@reached_if
@~\+ cd .+/tests
@ + A=aaa
@ + export A
@ + true
@ + : goal1
@~\+ cd .+/tests
@ + A=aaa
@ + export A
@ + echo goal1
@ + : default
@~\+ cd .+/tests
@ + A=aaa
@ + export A
@~\+ echo '?A=aaa'?

$ ./{{MAKESURE}} -f tests/4_trace.sh --tracing
|   goal 'goal2' [already satisfied].
|   goal 'goal1' ...
| goal1
|   goal 'default' ...
| A=aaa
